<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
    
    <xacro:property name="arm_base_length" value="0.1"/>
    <xacro:property name="arm_base_width" value="0.1"/>
    <xacro:property name="arm_base_height" value="0.05"/>
    <xacro:property name="arm_base_weight" value="0.01"/>

    <xacro:property name="arm_first_segment_radius" value="0.02"/>
    <xacro:property name="arm_first_segment_length" value="0.3"/>
    <xacro:property name="arm_first_segment_mass" value="0.1"/>
    <xacro:property name="arm_second_segment_radius" value="0.02"/>
    <xacro:property name="arm_second_segment_length" value="0.2"/>
    <xacro:property name="arm_second_segment_mass" value="0.05"/>

    <link name="arm_base_link">
        <visual>
            <geometry>
                <box size="${arm_base_length} ${arm_base_width} ${arm_base_height}"/>
            </geometry>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <material name="black"/>                
        </visual>

        <collision>
            <geometry>
                <box size="${arm_base_length} ${arm_base_width} ${arm_base_height}"/>
            </geometry>
            <origin xyz="0 0 0" rpy="0 0 0"/>
        </collision>

        <xacro:box_inertia mass="${arm_base_weight}" x="${arm_base_length}" y="${arm_base_width}" z="${arm_base_height}"
                            o_xyz="0 0 0" o_rpy="0 0 0"/>
    </link>

    <link name="arm_first_segment_link">
        <visual>
            <geometry>
                <cylinder radius="${arm_first_segment_radius}" length="${arm_first_segment_length}"/>
            </geometry>
            <origin xyz="0 0 ${arm_first_segment_length / 2.0}" rpy="0 0 0"/>
            <material name="green"/>                
        </visual>

        <collision>
            <geometry>
                <cylinder radius="${arm_first_segment_radius}" length="${arm_first_segment_length}"/>
            </geometry>
            <origin xyz="0 0 ${arm_first_segment_length / 2.0}" rpy="0 0 0"/>
        </collision>

        <xacro:cylinder_inertia mass="${arm_first_segment_mass}" radius="${arm_first_segment_radius}" height="${arm_first_segment_length}"
                            o_xyz="0 0 ${arm_first_segment_length / 2.0}" o_rpy="0 0 0"/>
    </link>

    <link name="arm_second_segment_link">
        <visual>
            <geometry>
                <cylinder radius="${arm_second_segment_radius}" length="${arm_second_segment_length}"/>
            </geometry>
            <origin xyz="0 0 ${arm_second_segment_length / 2.0}" rpy="0 0 0"/>
            <material name="green"/>                
        </visual>

        <collision>
            <geometry>
                <cylinder radius="${arm_second_segment_radius}" length="${arm_second_segment_length}"/>
            </geometry>
            <origin xyz="0 0 ${arm_second_segment_length / 2.0}" rpy="0 0 0"/>
        </collision>

        <xacro:cylinder_inertia mass="${arm_second_segment_mass}" radius="${arm_second_segment_radius}" height="${arm_second_segment_length}"
                            o_xyz="0 0 ${arm_second_segment_length / 2.0}" o_rpy="0 0 0"/>
    </link>


    <joint name="base_arm_base_joint" type="fixed">
        <parent link="base_link"/>
        <child link="arm_base_link"/>
        <origin xyz="${(base_length - arm_base_length) / 2.0} 0 ${base_height + (arm_base_height / 2.0)}" rpy="0 0 0"/>
    </joint>

    <joint name="arm_base_arm_first_segment_joint" type="revolute">
        <parent link="arm_base_link"/>
        <child link="arm_first_segment_link"/>
        <origin xyz="0 0 ${arm_base_height / 2.0}" rpy="0 0 0"/>
        <axis xyz="0 1 0"/>
        <limit lower="${pi / 2.0}" upper="0" effort="100" velocity="100"/>
        <dynamics damping="0.3" friction="0.3"/>
    </joint>

    <joint name="arm_first_segment_arm_second_segment_joint" type="revolute">
        <parent link="arm_first_segment_link"/>
        <child link="arm_second_segment_link"/>
        <origin xyz="0 0 ${arm_first_segment_length}" rpy="0 0 0"/>
        <axis xyz="0 1 0"/>
        <limit lower="${pi / 2.0}" upper="${-pi / 2.0}" effort="100" velocity="100"/>
        <dynamics damping="0.3" friction="0.3"/>
    </joint>

</robot>